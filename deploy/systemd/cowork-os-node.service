[Unit]
Description=idexal CoWork (Node-Only, Headless)
After=network.target

[Service]
Type=simple

# Path where you cloned/built idexal CoWork on the VPS.
WorkingDirectory=/opt/idexal-cowork

# Optional env file (LLM keys, data dir, control plane host/port, etc).
EnvironmentFile=-/etc/idexal-cowork.env

# Node-only daemon: no Electron/Xvfb required.
ExecStart=/usr/bin/node /opt/idexal/bin/coworkd-node.js

Restart=on-failure
RestartSec=5

# Run as an unprivileged user (recommended).
User=cowork
Group=cowork
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
CapabilityBoundingSet=
ReadWritePaths=/var/lib/idexal-cowork /srv/cowork/workspace

[Install]
WantedBy=multi-user.target
