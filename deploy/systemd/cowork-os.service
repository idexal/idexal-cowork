[Unit]
Description=idexal CoWork (Headless)
After=network.target

[Service]
Type=simple

# Path where you cloned/built idexal CoWork on the VPS.
WorkingDirectory=/opt/idexal-cowork

# Optional env file (LLM keys, data dir, control plane host/port, etc).
EnvironmentFile=-/etc/idexal-cowork.env

# Headless Electron can fail on some servers without a DISPLAY. Xvfb provides a virtual display.
ExecStart=/usr/bin/xvfb-run -a /usr/bin/node /opt/idexal/bin/coworkd.js

Restart=on-failure
RestartSec=5

# Run as an unprivileged user (recommended).
User=cowork
Group=cowork
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
CapabilityBoundingSet=
ReadWritePaths=/var/lib/idexal-cowork /srv/idexal-CoWork/workspace

[Install]
WantedBy=multi-user.target
